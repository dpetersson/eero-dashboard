# eero Dashboard — Backend Environment Variables
# Copy to .env and adjust for local development.

# Dry-run mode: intercepts mutation API calls with mock responses.
# Safe mutations (settings, SQM, DNS, guest network, pause device) return
# mock data. Unsafe mutations (reboot, profiles, blacklist, etc.) are blocked.
# See CONTRIBUTING.md for the full endpoint table.
# NEVER enable in production.
EERO_DRY_RUN=false

# Demo mode: bypasses auth and serves canned synthetic data for every read
# endpoint. Mutations no-op. Real users NEVER see this data — it is OFF by
# default. See docs/demo-data-mode.md and issue #45 for context.
# Useful for: screenshots, marketing, UI dev without an eero account.
# NEVER enable in production.
# EERO_DEMO_DATA=false

# Watch (device inventory + alerts). See docs/watch.md
# WATCH_ENABLED=true
# WATCH_POLL_SECONDS=300
# WATCH_WEBHOOK=https://ntfy.sh/your-private-topic
# WATCH_NEW_DAYS=7
# WATCH_ABSENT_DAYS=14
# WATCH_UPLOAD_RATIO=0.9
# WATCH_UPLOAD_SAMPLES=12
# Built-in LAN sweep (needs host networking in Docker). See docs/watch.md
# WATCH_LAN_SCAN=false
# WATCH_LAN_SCAN_SECONDS=900
# WATCH_LAN_SCAN_SUBNET=192.168.7.0/24
# LAN-only guard: only loopback / RFC1918 sources may use the API.
# Tighten to the home subnet when running with host networking.
# WATCH_LAN_ONLY=true
# WATCH_ALLOWED_CIDRS=192.168.7.0/24

# Speed test configuration
# SPEED_HISTORY_DAYS=365
# SPEED_TEST_POLL_INTERVAL=10
# SPEED_TEST_TIMEOUT=120
